# NextOpportunityFind Environment Configuration Template
# Copy to .env in root or backend directory to configure secrets.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DATA_ENCRYPTION_KEY=your_aes256_encryption_key_here
API_KEY_SECRET=your_jwt_secret_here

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

DATABASE_URL=sqlite:///./nextoppr.db
PORT=8000
