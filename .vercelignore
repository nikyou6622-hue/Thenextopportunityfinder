# Vercel Function Exclusions
# Exclude heavy local environments, raw assets, test suites, and build artifacts from serverless function bundles

# Python virtual environments & scratch
scratch/
env/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Raw media & local video assets
UI/
UI/res/
*.mov
*.avi
!web/public/intro.mp4
!public/intro.mp4

# Local build outputs & caches
.vite/
.next/
.cache/

# Local node_modules (Vercel installs dependencies separately during build)
node_modules/
web/node_modules/

# Local database & temp files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.log
npm-debug.log*

# Unit test files and migration test scripts (not needed in production Vercel function)
backend/test_*.py
backend/scripts/

# IDE & system artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
