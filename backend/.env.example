# NextOpportunityFind Backend Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in your private API credentials.
# NEVER commit real .env files to source control.

# AI & LLM Model API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Security & Data Encryption (DPDP Act 2023 AES-256 Key)
DATA_ENCRYPTION_KEY=your_secure_encryption_secret_here
API_KEY_SECRET=your_api_key_secret_here

# Google OAuth 2.0 Single Sign-On (SSO)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=nextoppr

# Email & Outreach Engine (Transactional SMTP)
DEFAULT_EMAIL=your_email@domain.com
ADMIN_EMAIL=admin@domain.com
SENDER_EMAIL=outreach@domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_app_password_here

# Database & Runtime Server Configuration
DATABASE_URL=sqlite:///./nextoppr.db
HOST=0.0.0.0
PORT=8000
